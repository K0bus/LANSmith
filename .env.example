# Base de données SQLite locale pour Prisma
DATABASE_URL="file:./dev.db"

# Twitch Developer / IGDB API Credentials
# Obtenez vos identifiants sur https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID="your_twitch_client_id_here"
TWITCH_CLIENT_SECRET="your_twitch_client_secret_here"

# IsThereAnyDeal (ITAD) API Key (Optionnel mais recommandé pour les prix réels en direct de 35+ boutiques)
# Obtenez votre clé gratuite sur https://isthereanydeal.com/
ITAD_API_KEY="your_itad_api_key_here"

# Nuxt App Config
NUXT_PUBLIC_APP_NAME="LANSmith"
