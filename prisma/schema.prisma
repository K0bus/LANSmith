datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Participant {
  id          String            @id @default(cuid())
  nickname    String            @unique
  avatarUrl   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  rig         Rig?
  scores           TournamentScore[]
  roundScores      RoundScore[]
  matchesAsPlayer1 TournamentMatch[] @relation("Player1Matches")
  matchesAsPlayer2 TournamentMatch[] @relation("Player2Matches")
  tournamentTeams  TournamentTeam[]  @relation("TournamentTeamParticipants")
}

model Rig {
  id            String      @id @default(cuid())
  participantId String      @unique
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  cpuName       String
  cpuNormalized String
  cpuScore      Int
  
  gpuName       String
  gpuNormalized String
  gpuScore      Int
  vramGb        Int
  
  ramGb         Int
  os            String      @default("Windows")
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BenchmarkGpu {
  id          String   @id @default(cuid())
  name        String   @unique
  normalized  String   @unique
  score       Int      // G3D Mark
  tier        Int      // 1 (Entry) à 5 (Enthusiast)
  updatedAt   DateTime @updatedAt
}

model BenchmarkCpu {
  id          String   @id @default(cuid())
  name        String   @unique
  normalized  String   @unique
  score       Int      // CPU Mark (Gaming/Single-Thread)
  tier        Int      // 1 à 5
  updatedAt   DateTime @updatedAt
}

model Game {
  id                String            @id @default(cuid())
  igdbId            Int               @unique
  name              String
  slug              String
  coverUrl          String?
  summary           String?
  genres            String?
  steamAppId        String?
  
  // Requirements chiffrés pour le matching
  minCpuScore       Int               @default(0)
  recCpuScore       Int               @default(0)
  minGpuScore       Int               @default(0)
  recGpuScore       Int               @default(0)
  minRamGb          Int               @default(8)
  recRamGb          Int               @default(16)
  minVramGb         Int               @default(2)
  recVramGb         Int               @default(6)
  
  // Suivi dynamique des prix et modes d'acquisition
  steamPriceCents   Int?              @map("steam_price_cents")
  keyshopPriceCents Int?              @map("keyshop_price_cents")
  keyshopUrl        String?           @map("keyshop_url")
  currency          String            @default("EUR")
  priceUpdatedAt    DateTime?         @map("price_updated_at")
  acquisitionType   String            @default("STORE_BUY") @map("acquisition_type") // STORE_BUY, FREE_TO_PLAY, FRIEND_SHARE
  friendDownloadUrl String?           @map("friend_download_url")
  
  tournaments       Tournament[]
  tournamentGames   TournamentGame[]
  scores            TournamentScore[]
  createdAt         DateTime          @default(now())
}

model Tournament {
  id              String            @id @default(cuid())
  name            String
  status          String            @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED
  scoringRules    String?           // JSON string of scoring scale
  games           Game[]
  tournamentGames TournamentGame[]
  scores          TournamentScore[]
  createdAt       DateTime          @default(now())
}

model TournamentGame {
  id           String            @id @default(cuid())
  tournamentId String
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  gameId       String
  game         Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  scoringType  String            @default("SCOREBOARD") // SCOREBOARD, WIN_LOSE, or ROUND_ROBIN
  teamSize     Int               @default(1) // 1 = Solo (1v1), 2 = Duo (2v2), 3 = Trio, etc.
  order        Int               @default(0)
  
  rounds       TournamentRound[]
  matches      TournamentMatch[]
  teams        TournamentTeam[]
  createdAt    DateTime          @default(now())

  @@unique([tournamentId, gameId])
}

model TournamentTeam {
  id               String            @id @default(cuid())
  tournamentGameId String
  tournamentGame   TournamentGame    @relation(fields: [tournamentGameId], references: [id], onDelete: Cascade)
  
  name             String            // e.g. "Duo #1"
  seed             Int               @default(1)
  
  members          Participant[]     @relation("TournamentTeamParticipants")
  
  matchesAsTeam1   TournamentMatch[] @relation("Team1Matches")
  matchesAsTeam2   TournamentMatch[] @relation("Team2Matches")
  
  createdAt        DateTime          @default(now())
}

model TournamentRound {
  id               String          @id @default(cuid())
  tournamentGameId String
  tournamentGame   TournamentGame  @relation(fields: [tournamentGameId], references: [id], onDelete: Cascade)
  
  roundNumber      Int             @default(1)
  name             String?         // e.g. "Manche 1", "Finale"
  
  scores           RoundScore[]
  createdAt        DateTime        @default(now())

  @@unique([tournamentGameId, roundNumber])
}

model RoundScore {
  id            String          @id @default(cuid())
  roundId       String
  round         TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  isWinner      Boolean?
  rank          Int?
  rawScore      Float?
  points        Float           @default(0)
  
  createdAt     DateTime        @default(now())

  @@unique([roundId, participantId])
}

model TournamentScore {
  id            String      @id @default(cuid())
  tournamentId  String
  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  gameId        String
  game          Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  rank          Int?
  rawScore      Float?
  points        Int         @default(0)
  
  createdAt     DateTime    @default(now())

  @@unique([tournamentId, participantId, gameId])
}

model TournamentMatch {
  id               String          @id @default(cuid())
  tournamentGameId String
  tournamentGame   TournamentGame  @relation(fields: [tournamentGameId], references: [id], onDelete: Cascade)
  
  roundNumber      Int             @default(1) // Tour 1, 2...
  matchNumber      Int             @default(1) // Match 1, 2...
  
  // For Solo mode (1v1)
  player1Id        String?
  player1          Participant?    @relation("Player1Matches", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id        String?         // Null if BYE
  player2          Participant?    @relation("Player2Matches", fields: [player2Id], references: [id], onDelete: Cascade)
  
  // For Team mode (Duo, Trio...)
  team1Id          String?
  team1            TournamentTeam? @relation("Team1Matches", fields: [team1Id], references: [id], onDelete: Cascade)
  team2Id          String?         // Null if BYE
  team2            TournamentTeam? @relation("Team2Matches", fields: [team2Id], references: [id], onDelete: Cascade)
  
  player1Score     Float?
  player2Score     Float?
  
  winnerId         String?         // ID of winner player
  winnerTeamId     String?         // ID of winner team
  isDraw           Boolean         @default(false)
  status           String          @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([tournamentGameId, roundNumber, matchNumber])
}


